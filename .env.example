NODE_ENV=development

WEB_PORT=5173
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:4000/api/v1
VITE_LISTINGS_SOURCE=api

POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace_dev
POSTGRES_DB=gaming_marketplace
POSTGRES_PORT=5433
DATABASE_URL=postgresql://marketplace:marketplace_dev@localhost:5433/gaming_marketplace?schema=public

REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

JWT_SECRET=replace-with-a-long-random-development-secret
AUTH_COOKIE_NAME=gm_session
AUTH_SESSION_TTL_SECONDS=604800
LOG_LEVEL=info

DEMO_ADMIN_EMAIL=admin@gaming.local
DEMO_ADMIN_PASSWORD=Admin123!
DEMO_BUYER_EMAIL=buyer@gaming.local
DEMO_BUYER_PASSWORD=Buyer123!
DEMO_SELLER_EMAIL=seller@gaming.local
DEMO_SELLER_PASSWORD=Seller123!

UPLOAD_DIR=./uploads
MEDIA_PUBLIC_URL=http://127.0.0.1:4000/uploads
COIN_TRY_RATE=1
AUTO_CONFIRMATION_HOURS=24
# Fractional hours are supported for local demos (0.01 = 36 seconds).
ORDER_JOBS_ENABLED=true
ORDER_JOB_RECONCILE_MS=30000
WITHDRAWAL_FEE_RATE=0

# Private Cloudflare R2 bucket for optional game inventory scan videos.
# Keep real credentials only in .env; never commit them or enter them in the Admin UI.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=gaming-marketplace-inventory-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional. When omitted the API derives https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_REGION=auto
R2_UPLOAD_URL_TTL_SECONDS=1800
R2_READ_URL_TTL_SECONDS=900

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=
INVENTORY_ANALYSIS_MAX_BYTES=157286400
INVENTORY_VIDEO_RETENTION_MINUTES=120
INVENTORY_JOBS_ENABLED=true
INVENTORY_JOB_RECONCILE_MS=30000
