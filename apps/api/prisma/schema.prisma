generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum ListingStatus {
  ACTIVE
  INACTIVE
}

enum ListingMediaRole {
  COVER
  GALLERY
  VIDEO
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  HOLD
  RELEASE
  SALE
  REFUND
}

enum OrderStatus {
  Created
  Paid
  WaitingDelivery
  Delivered
  WaitingConfirmation
  Completed
  SupportPaused
  Cancelled
}

enum TicketStatus {
  Open
  InProgress
  Answered
  Closed
}

enum SimulationStatus {
  COMPLETED
}

enum InventoryAnalysisStatus {
  AWAITING_UPLOAD
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model User {
  id                String              @id @default(uuid()) @db.Uuid
  name              String              @db.VarChar(100)
  email             String              @unique @db.VarChar(255)
  passwordHash      String              @map("password_hash") @db.VarChar(255)
  role              UserRole            @default(BUYER)
  status            UserStatus          @default(ACTIVE)
  wallet            Wallet?
  listings          Listing[]
  purchases         Order[]             @relation("OrderBuyer")
  sales             Order[]             @relation("OrderSeller")
  orderEvents       OrderEvent[]
  buyerChats        Conversation[]      @relation("ChatBuyer")
  sellerChats       Conversation[]      @relation("ChatSeller")
  messages          Message[]
  tickets           SupportTicket[]
  reviewsGiven      Review[]            @relation("ReviewBuyer")
  reviewsReceived   Review[]            @relation("ReviewSeller")
  notifications     Notification[]
  adminAuditLogs    AdminAuditLog[]     @relation("AdminAuditActor")
  inventoryAnalyses InventoryAnalysis[]
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@map("users")
}

model Wallet {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @unique @map("user_id") @db.Uuid
  availableBalance Decimal             @default(0) @map("available_balance") @db.Decimal(18, 2)
  heldBalance      Decimal             @default(0) @map("held_balance") @db.Decimal(18, 2)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     WalletTransaction[]
  deposits         Deposit[]
  withdrawals      Withdrawal[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@map("wallets")
}

model SystemSettings {
  id                    Int      @id @default(1)
  coinTryRate           Decimal  @map("coin_try_rate") @db.Decimal(18, 6)
  withdrawalFeeRate     Decimal  @default(0) @map("withdrawal_fee_rate") @db.Decimal(9, 6)
  autoConfirmationHours Decimal  @default(24) @map("auto_confirmation_hours") @db.Decimal(9, 4)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model WalletTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  walletId        String                @map("wallet_id") @db.Uuid
  type            WalletTransactionType
  amount          Decimal               @db.Decimal(18, 2)
  fee             Decimal               @default(0) @db.Decimal(18, 2)
  idempotencyKey  String                @unique @map("idempotency_key") @db.VarChar(100)
  availableBefore Decimal               @map("available_before") @db.Decimal(18, 2)
  availableAfter  Decimal               @map("available_after") @db.Decimal(18, 2)
  heldBefore      Decimal               @map("held_before") @db.Decimal(18, 2)
  heldAfter       Decimal               @map("held_after") @db.Decimal(18, 2)
  description     String                @default("") @db.VarChar(255)
  ledgerSequence  Int                   @unique @default(autoincrement()) @map("ledger_sequence")
  wallet          Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  orderId         String?               @map("order_id") @db.Uuid
  order           Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  deposit         Deposit?
  withdrawal      Withdrawal?
  createdAt       DateTime              @default(now()) @map("created_at")

  @@unique([orderId, type])
  @@index([walletId, ledgerSequence])
  @@index([orderId])
  @@map("wallet_transactions")
}

model Deposit {
  id             String            @id @default(uuid()) @db.Uuid
  walletId       String            @map("wallet_id") @db.Uuid
  transactionId  String            @unique @map("transaction_id") @db.Uuid
  amountTry      Decimal           @map("amount_try") @db.Decimal(18, 2)
  coinTryRate    Decimal           @map("coin_try_rate") @db.Decimal(18, 6)
  coinAmount     Decimal           @map("coin_amount") @db.Decimal(18, 2)
  idempotencyKey String            @unique @map("idempotency_key") @db.VarChar(100)
  status         SimulationStatus  @default(COMPLETED)
  wallet         Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction    WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([walletId, createdAt])
  @@map("deposits")
}

model Withdrawal {
  id                String            @id @default(uuid()) @db.Uuid
  walletId          String            @map("wallet_id") @db.Uuid
  transactionId     String            @unique @map("transaction_id") @db.Uuid
  amountCoin        Decimal           @map("amount_coin") @db.Decimal(18, 2)
  coinTryRate       Decimal           @map("coin_try_rate") @db.Decimal(18, 6)
  feeRate           Decimal           @map("fee_rate") @db.Decimal(9, 6)
  feeCoin           Decimal           @map("fee_coin") @db.Decimal(18, 2)
  netAmountTry      Decimal           @map("net_amount_try") @db.Decimal(18, 2)
  ibanMasked        String            @map("iban_masked") @db.VarChar(32)
  accountHolderName String            @map("account_holder_name") @db.VarChar(100)
  idempotencyKey    String            @unique @map("idempotency_key") @db.VarChar(100)
  status            SimulationStatus  @default(COMPLETED)
  wallet            Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction       WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([walletId, createdAt])
  @@map("withdrawals")
}

model Category {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique @db.VarChar(100)
  slug        String        @unique @db.VarChar(100)
  description String        @db.Text
  status      CatalogStatus @default(ACTIVE)
  listings    Listing[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("categories")
}

model Game {
  id                   String                    @id @default(uuid()) @db.Uuid
  name                 String                    @unique @db.VarChar(100)
  slug                 String                    @unique @db.VarChar(100)
  status               CatalogStatus             @default(ACTIVE)
  listings             Listing[]
  inferenceIntegration GameInferenceIntegration?
  inventoryAnalyses    InventoryAnalysis[]
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  @@map("games")
}

model Listing {
  id                String              @id @default(uuid()) @db.Uuid
  sellerId          String              @map("seller_id") @db.Uuid
  categoryId        String              @map("category_id") @db.Uuid
  gameId            String?             @map("game_id") @db.Uuid
  title             String              @db.VarChar(160)
  description       String              @db.Text
  price             Decimal             @db.Decimal(18, 2)
  status            ListingStatus       @default(ACTIVE)
  seller            User                @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category          Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  game              Game?               @relation(fields: [gameId], references: [id], onDelete: SetNull)
  media             ListingMedia[]
  orders            Order[]
  conversations     Conversation[]
  inventoryAnalyses InventoryAnalysis[]
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([gameId, status, createdAt])
  @@index([sellerId, createdAt])
  @@map("listings")
}

model GameInferenceIntegration {
  id              String   @id @default(uuid()) @db.Uuid
  gameId          String   @unique @map("game_id") @db.Uuid
  provider        String   @default("EXTERNAL_API") @db.VarChar(40)
  baseUrl         String?  @map("base_url") @db.VarChar(500)
  apiKeyEncrypted String?  @map("api_key_encrypted") @db.Text
  apiKeyLastFour  String?  @map("api_key_last_four") @db.VarChar(4)
  enabled         Boolean  @default(false)
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("game_inference_integrations")
}

model InventoryAnalysis {
  id               String                  @id @default(uuid()) @db.Uuid
  listingId        String                  @map("listing_id") @db.Uuid
  sellerId         String                  @map("seller_id") @db.Uuid
  gameId           String                  @map("game_id") @db.Uuid
  status           InventoryAnalysisStatus @default(AWAITING_UPLOAD)
  storageKey       String                  @unique @map("storage_key") @db.VarChar(500)
  originalFileName String                  @map("original_file_name") @db.VarChar(255)
  mimeType         String                  @map("mime_type") @db.VarChar(100)
  sizeBytes        Int                     @map("size_bytes")
  providerJobId    String?                 @map("provider_job_id") @db.VarChar(160)
  rawResponse      Json?                   @map("raw_response")
  output           Json?
  errorMessage     String?                 @map("error_message") @db.VarChar(1000)
  uploadExpiresAt  DateTime                @map("upload_expires_at")
  startedAt        DateTime?               @map("started_at")
  completedAt      DateTime?               @map("completed_at")
  deleteAfter      DateTime                @map("delete_after")
  deletedAt        DateTime?               @map("deleted_at")
  listing          Listing                 @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller           User                    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  game             Game                    @relation(fields: [gameId], references: [id], onDelete: Restrict)
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@index([listingId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@index([deletedAt, deleteAfter])
  @@map("inventory_analyses")
}

model ListingMedia {
  id         String           @id @default(uuid()) @db.Uuid
  listingId  String           @map("listing_id") @db.Uuid
  role       ListingMediaRole
  storageKey String           @unique @map("storage_key") @db.VarChar(500)
  mimeType   String           @map("mime_type") @db.VarChar(100)
  sizeBytes  Int              @map("size_bytes")
  altText    String           @map("alt_text") @db.VarChar(255)
  sortOrder  Int              @default(0) @map("sort_order")
  listing    Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([listingId, role, sortOrder])
  @@map("listing_media")
}

model Order {
  id                String              @id @default(uuid()) @db.Uuid
  buyerId           String              @map("buyer_id") @db.Uuid
  sellerId          String              @map("seller_id") @db.Uuid
  listingId         String              @map("listing_id") @db.Uuid
  listingTitle      String              @map("listing_title") @db.VarChar(160)
  price             Decimal             @db.Decimal(18, 2)
  status            OrderStatus         @default(Created)
  idempotencyKey    String              @map("idempotency_key") @db.VarChar(100)
  deliveryNote      String?             @map("delivery_note") @db.VarChar(2000)
  deliveredAt       DateTime?           @map("delivered_at")
  autoConfirmAt     DateTime?           @map("auto_confirm_at")
  confirmedAt       DateTime?           @map("confirmed_at")
  completedAt       DateTime?           @map("completed_at")
  cancelledAt       DateTime?           @map("cancelled_at")
  pausedFrom        OrderStatus?        @map("paused_from")
  pausedRemainingMs Int?                @map("paused_remaining_ms")
  buyer             User                @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller            User                @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  listing           Listing             @relation(fields: [listingId], references: [id], onDelete: Restrict)
  events            OrderEvent[]
  transactions      WalletTransaction[]
  conversation      Conversation?
  tickets           SupportTicket[]
  review            Review?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([status, autoConfirmAt])
  @@map("orders")
}

model OrderEvent {
  id        Int         @id @default(autoincrement())
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  actorId   String?     @map("actor_id") @db.Uuid
  actorRole String      @map("actor_role") @db.VarChar(10)
  note      String      @db.VarChar(2000)
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([orderId, id])
  @@map("order_events")
}

model Conversation {
  id         String    @id @default(uuid()) @db.Uuid
  contextKey String    @unique @map("context_key") @db.VarChar(100)
  buyerId    String    @map("buyer_id") @db.Uuid
  sellerId   String    @map("seller_id") @db.Uuid
  listingId  String    @map("listing_id") @db.Uuid
  orderId    String?   @unique @map("order_id") @db.Uuid
  buyer      User      @relation("ChatBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller     User      @relation("ChatSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages   Message[]
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
  @@map("conversations")
}

model SupportTicket {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  orderId   String?      @map("order_id") @db.Uuid
  subject   String       @db.VarChar(160)
  status    TicketStatus @default(Open)
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  messages  Message[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([userId, status, createdAt])
  @@index([orderId, status])
  @@map("support_tickets")
}

model Message {
  id             String         @id @default(uuid()) @db.Uuid
  senderId       String         @map("sender_id") @db.Uuid
  conversationId String?        @map("conversation_id") @db.Uuid
  ticketId       String?        @map("ticket_id") @db.Uuid
  body           String         @db.VarChar(2000)
  sender         User           @relation(fields: [senderId], references: [id], onDelete: Restrict)
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ticket         SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([conversationId, createdAt, id])
  @@index([ticketId, createdAt, id])
  @@map("messages")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @unique @map("order_id") @db.Uuid
  buyerId   String   @map("buyer_id") @db.Uuid
  sellerId  String   @map("seller_id") @db.Uuid
  rating    Int
  comment   String   @default("") @db.VarChar(1000)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyer     User     @relation("ReviewBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller    User     @relation("ReviewSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sellerId, createdAt])
  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(40)
  title     String   @db.VarChar(160)
  message   String   @db.VarChar(500)
  href      String   @db.VarChar(200)
  isRead    Boolean  @default(false) @map("is_read")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  adminId    String   @map("admin_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.VarChar(100)
  details    Json     @default("{}")
  admin      User     @relation("AdminAuditActor", fields: [adminId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("admin_audit_logs")
}
