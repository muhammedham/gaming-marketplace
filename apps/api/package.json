{
  "name": "@gaming-marketplace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test": "vitest run --pool=forks --maxWorkers=1",
    "test:watch": "vitest",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/jwt": "10.2.2",
    "@prisma/client": "6.19.3",
    "@sinclair/typebox": "0.34.52",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "fastify": "5.12.0",
    "fastify-plugin": "6.0.0",
    "ioredis": "6.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "dotenv-cli": "11.0.0",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prisma": "6.19.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
