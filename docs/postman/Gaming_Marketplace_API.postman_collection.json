{
  "info": {
    "name": "Gaming Marketplace API",
    "description": "Sprint 1 Auth endpoints are implemented. Listings, Wallet, Orders and Support requests are contracts for upcoming sprints. Login cookies are stored automatically by Postman's cookie jar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{healthUrl}}",
        "description": "Implemented. Checks API, PostgreSQL and Redis availability."
      }
    },
    {
      "name": "Auth - Sprint 1 Implemented",
      "item": [
        {
          "name": "Register Buyer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Buyer\",\n  \"email\": \"new-buyer@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"role\": \"BUYER\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Creates User and zero-balance Wallet in one transaction, then sets gm_session cookie. Change the email before repeating."
          }
        },
        {
          "name": "Login Demo Buyer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoBuyerEmail}}\",\n  \"password\": \"{{demoBuyerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Sets the HttpOnly gm_session cookie used by following requests."
          }
        },
        {
          "name": "Login Demo Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoAdminEmail}}\",\n  \"password\": \"{{demoAdminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Use before Admin Session to replace the current cookie with an Admin session."
          }
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "description": "Returns the authenticated user and Wallet balances from the session cookie."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "description": "Clears gm_session and returns 204."
          }
        }
      ]
    },
    {
      "name": "Listings - Future Sprint",
      "item": [
        {
          "name": "List Listings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/listings?page=1&limit=20"
          }
        },
        {
          "name": "Get Listing",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/listings/{{listingId}}"
          }
        },
        {
          "name": "Create Listing",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"category-id\",\n  \"gameId\": null,\n  \"title\": \"Example listing\",\n  \"description\": \"Example description\",\n  \"price\": \"100.00\"\n}"
            },
            "url": "{{baseUrl}}/listings"
          }
        }
      ]
    },
    {
      "name": "Wallet - Future Sprint",
      "item": [
        {
          "name": "Wallet Summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallet"
          }
        },
        {
          "name": "Simulate Deposit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amountTry\": \"500.00\"\n}" },
            "url": "{{baseUrl}}/wallet/deposits/simulate"
          }
        },
        {
          "name": "Simulate Withdrawal",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": \"100.00\",\n  \"iban\": \"TR000000000000000000000000\"\n}" },
            "url": "{{baseUrl}}/wallet/withdrawals/simulate"
          }
        }
      ]
    },
    {
      "name": "Orders - Future Sprint",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"listingId\": \"{{listingId}}\"\n}" },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Deliver Order",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders/{{orderId}}/deliver"
          }
        },
        {
          "name": "Confirm Order",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders/{{orderId}}/confirm"
          }
        }
      ]
    },
    {
      "name": "Support - Future Sprint",
      "item": [
        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"subject\": \"Order problem\",\n  \"message\": \"Describe the problem\"\n}"
            },
            "url": "{{baseUrl}}/support/tickets"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin Session - Sprint 1 Implemented",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/session",
            "description": "Sprint 1 role-boundary proof. Login as Admin first. Buyer and Seller receive 403."
          }
        },
        {
          "name": "List Users - Future Sprint",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/users?page=1&limit=20"
          }
        }
      ]
    }
  ]
}
