{
  "info": {
    "name": "Gaming Marketplace API",
    "description": "Sprint 0 API contract skeleton. Endpoints will be implemented incrementally during Sprint 1-5.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"buyer-demo\",\n  \"email\": \"buyer@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"role\": \"buyer\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"buyer@example.com\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Current User",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        }
      ]
    },
    {
      "name": "Listings",
      "item": [
        {
          "name": "List Listings",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/listings?page=1&limit=20"
          }
        },
        {
          "name": "Get Listing",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/listings/{{listingId}}"
          }
        },
        {
          "name": "Create Listing",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"category-id\",\n  \"gameId\": null,\n  \"title\": \"Example listing\",\n  \"description\": \"Example description\",\n  \"price\": \"100.00\"\n}"
            },
            "url": "{{baseUrl}}/listings"
          }
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Wallet Summary",
          "request": { "method": "GET", "url": "{{baseUrl}}/wallet" }
        },
        {
          "name": "Simulate Deposit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amountTry\": \"500.00\"\n}" },
            "url": "{{baseUrl}}/wallet/deposits/simulate"
          }
        },
        {
          "name": "Simulate Withdrawal",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": \"100.00\",\n  \"iban\": \"TR000000000000000000000000\"\n}" },
            "url": "{{baseUrl}}/wallet/withdrawals/simulate"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"listingId\": \"{{listingId}}\"\n}" },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Deliver Order",
          "request": { "method": "POST", "url": "{{baseUrl}}/orders/{{orderId}}/deliver" }
        },
        {
          "name": "Confirm Order",
          "request": { "method": "POST", "url": "{{baseUrl}}/orders/{{orderId}}/confirm" }
        }
      ]
    },
    {
      "name": "Support",
      "item": [
        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"subject\": \"Order problem\",\n  \"message\": \"Describe the problem\"\n}"
            },
            "url": "{{baseUrl}}/support/tickets"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List Users",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/users?page=1&limit=20" }
        }
      ]
    }
  ]
}

