{
  "info": {
    "name": "Gaming Marketplace - Final MVP API",
    "description": "Final Sprint 5 collection covering Auth, Listings, Wallet simulations, Orders, Support and the complete Admin API. Import Gaming_Marketplace_Sprint_4.postman_collection.json for extended Chat/Reviews/Notifications alternatives. Login cookies are stored automatically by Postman's cookie jar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{healthUrl}}",
        "description": "Implemented. Checks API, PostgreSQL and Redis availability."
      }
    },
    {
      "name": "Auth - Sprint 1 Implemented",
      "item": [
        {
          "name": "Register Buyer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Buyer\",\n  \"email\": \"new-buyer@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"role\": \"BUYER\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Creates User and zero-balance Wallet in one transaction, then sets gm_session cookie. Change the email before repeating."
          }
        },
        {
          "name": "Login Demo Buyer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoBuyerEmail}}\",\n  \"password\": \"{{demoBuyerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Sets the HttpOnly gm_session cookie used by following requests."
          }
        },
        {
          "name": "Login Demo Seller",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoSellerEmail}}\",\n  \"password\": \"{{demoSellerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Use before Seller listing create, edit, deactivate and media requests."
          }
        },
        {
          "name": "Login Demo Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoAdminEmail}}\",\n  \"password\": \"{{demoAdminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Use before Admin Session to replace the current cookie with an Admin session."
          }
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "description": "Returns the authenticated user and Wallet balances from the session cookie."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "description": "Clears gm_session and returns 204."
          }
        }
      ]
    },
    {
      "name": "Catalog and Listings - Sprint 2 Implemented",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories",
            "description": "Stores the first returned Category UUID in categoryId for later requests."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const items = pm.response.json().data.items;",
                "if (items.length) pm.environment.set('categoryId', items[0].id);"
              ]
            }
          }]
        },
        {
          "name": "List Games",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/games",
            "description": "Stores the first returned Game UUID in gameId for later requests."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const items = pm.response.json().data.items;",
                "if (items.length) pm.environment.set('gameId', items[0].id);"
              ]
            }
          }]
        },
        {
          "name": "List Listings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/listings?sort=newest&page=1&limit=12",
            "description": "Public ACTIVE listings. Add q, category, game, minPrice and maxPrice when testing combined filters."
          }
        },
        {
          "name": "Get Listing",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/listings/{{listingId}}"
          }
        },
        {
          "name": "My Listings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/listings/mine",
            "description": "Requires the Demo Seller session and returns ACTIVE plus INACTIVE owned listings."
          }
        },
        {
          "name": "Create Listing",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "categoryId", "value": "{{categoryId}}", "type": "text" },
                { "key": "gameId", "value": "{{gameId}}", "type": "text" },
                { "key": "title", "value": "Example listing", "type": "text" },
                { "key": "description", "value": "A complete marketplace listing description.", "type": "text" },
                { "key": "price", "value": "100.00", "type": "text" },
                { "key": "cover", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/listings",
            "description": "Login as Demo Seller, run Categories/Games, and choose a JPEG/PNG/WebP Cover file before sending."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 201) {",
                "  pm.environment.set('listingId', pm.response.json().data.id);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Update Listing",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"gameId\": \"{{gameId}}\",\n  \"title\": \"Updated example listing\",\n  \"description\": \"An updated marketplace listing description.\",\n  \"price\": \"125.00\"\n}"
            },
            "url": "{{baseUrl}}/listings/{{listingId}}"
          }
        },
        {
          "name": "Upload Listing Media",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "role", "value": "GALLERY", "type": "text" },
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/listings/{{listingId}}/media",
            "description": "Choose one allowed file. Change role to COVER, GALLERY or VIDEO as needed."
          }
        },
        {
          "name": "Deactivate Listing",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/listings/{{listingId}}/deactivate"
          }
        },
        {
          "name": "Activate Listing",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/listings/{{listingId}}/activate"
          }
        }
      ]
    },
    {
      "name": "Wallet - Sprint 3 Simulation",
      "item": [
        {
          "name": "Wallet Summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallet"
          }
        },
        {
          "name": "Simulate Deposit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amountTry\": \"500.00\",\n  \"idempotencyKey\": \"deposit-postman-001\"\n}" },
            "url": "{{baseUrl}}/wallet/deposits/simulate"
          }
        },
        {
          "name": "Withdrawal Preview",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amountCoin\": \"100.00\"\n}" },
            "url": "{{baseUrl}}/wallet/withdrawals/preview"
          }
        },
        {
          "name": "Simulate Withdrawal",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amountCoin\": \"100.00\",\n  \"iban\": \"TR000000000000000000000000\",\n  \"accountHolderName\": \"Demo Buyer\",\n  \"idempotencyKey\": \"withdraw-postman-001\"\n}" },
            "url": "{{baseUrl}}/wallet/withdrawals/simulate"
          }
        },
        {
          "name": "Transaction History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallet/transactions?page=1&limit=20"
          }
        },
        {
          "name": "Deposit History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallet/deposits?page=1&limit=20"
          }
        },
        {
          "name": "Withdrawal History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallet/withdrawals?page=1&limit=20"
          }
        }
      ]
    },
    {
      "name": "Orders - Sprint 4 (full examples in separate collection)",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"expectedPrice\": \"{{listingPrice}}\",\n  \"idempotencyKey\": \"{{$guid}}\"\n}" },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Deliver Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"deliveryNote\": \"The demo product has been delivered.\"\n}" },
            "url": "{{baseUrl}}/orders/{{orderId}}/deliver"
          }
        },
        {
          "name": "Confirm Order",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders/{{orderId}}/confirm"
          }
        }
      ]
    },
    {
      "name": "Support - Sprint 4 (full examples in separate collection)",
      "item": [
        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"subject\": \"Order problem\",\n  \"body\": \"Describe the problem\"\n}"
            },
            "url": "{{baseUrl}}/support/tickets"
          }
        }
      ]
    },
    {
      "name": "Admin - Sprint 5",
      "item": [
        {
          "name": "Admin Session",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/session",
            "description": "Login as Admin first. Buyer and Seller receive 403 for every route in this folder."
          }
        },
        {
          "name": "Dashboard + Wallet Ledger",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/dashboard"
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/users?page=1&limit=20&q=&status=ACTIVE"
          }
        },
        {
          "name": "Update User Role or Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\"\n}" },
            "url": "{{baseUrl}}/admin/users/{{targetUserId}}",
            "description": "The API prevents self-suspension and removal of the final active Admin."
          }
        },
        {
          "name": "Create Category",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.environment.set('adminCategoryId', pm.response.json().data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Final Category {{$timestamp}}\",\n  \"description\": \"Created from the final Admin collection.\"\n}" },
            "url": "{{baseUrl}}/admin/categories"
          }
        },
        {
          "name": "List Categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/categories?page=1&limit=20" }
        },
        {
          "name": "Deactivate Category",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"INACTIVE\"\n}" },
            "url": "{{baseUrl}}/admin/categories/{{adminCategoryId}}"
          }
        },
        {
          "name": "Create Game",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.environment.set('adminGameId', pm.response.json().data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Final Game {{$timestamp}}\"\n}" },
            "url": "{{baseUrl}}/admin/games"
          }
        },
        {
          "name": "List Games",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/games?page=1&limit=20" }
        },
        {
          "name": "List Listings",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/listings?page=1&limit=20&q=&status=" }
        },
        {
          "name": "Update Listing Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\"\n}" },
            "url": "{{baseUrl}}/admin/listings/{{listingId}}"
          }
        },
        {
          "name": "List Orders",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/orders?page=1&limit=20&status=" }
        },
        {
          "name": "Admin Order Action",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"action\": \"Complete\",\n  \"note\": \"Delivery evidence verified in final API demo.\"\n}" },
            "url": "{{baseUrl}}/admin/orders/{{orderId}}/action",
            "description": "Complete is allowed from WaitingConfirmation; Cancel is allowed from WaitingDelivery/WaitingConfirmation. SupportPaused is resolved from its ticket."
          }
        },
        {
          "name": "List Simulated Withdrawals",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/withdrawals?page=1&limit=20",
            "description": "Simulation records only. No real payment or bank transfer."
          }
        },
        {
          "name": "List Support",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/support?page=1&limit=20&status=Open" }
        },
        {
          "name": "Get Settings",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/settings" }
        },
        {
          "name": "Update Settings",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"coinTryRate\": \"1.000000\",\n  \"withdrawalFeeRate\": \"0.000000\",\n  \"autoConfirmationHours\": \"24.0000\"\n}" },
            "url": "{{baseUrl}}/admin/settings"
          }
        },
        {
          "name": "Audit Log",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/audit?page=1&limit=20"
          }
        }
      ]
    }
  ]
}
